{
  "backend": "mlx",
  "arch": "sgjm",
  "seed": 42,
  "model": {
    "vocab_size": 256,
    "d_model": 1024,
    "n_layers": 14,
    "n_heads": 16,
    "d_ff": 4096,
    "max_seq_len": 1024,
    "block_size": 4,
    "drafter_layers": 2,
    "drafter_d_model": 512,
    "drafter_heads": 8,
    "drafter_d_ff": 2048,
    "judge_hidden": 2048,
    "verifier_hidden": 1024,
    "dropout": 0.0,
    "tie_embeddings": true,
    "baseline_n_layers": 18
