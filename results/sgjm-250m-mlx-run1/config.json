    "weight_decay": 0.1,
    "warmup_steps": 1000,
    "max_steps": 10000,
    "grad_clip": 1.0,
    "batch_size": 4,
    "seq_len": 512,
    "eval_batches": 8
  },
  "loss": {
    "token": 1.0,
    "drafter": 0.5,
    "jepa": 0.25,
    "verifier": 0.1
  },
  "data_path": null,
  "data_source": "python_extended",
  "corpus_bytes": 33554432,
  "checkpoint_dir": "runs/sgjm-250m",
  "log_every": 25,
  "eval_every": 500,
  "checkpoint_every": 500,
  "amp": "auto",
  "compile": false
}